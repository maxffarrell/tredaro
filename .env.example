# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Public demo mode: throwaway sample workspaces, risky features disabled.
TREDARO_DEMO=

# Tredaro Cloud (only the hosted product sets this). Enables per-workspace
# Stripe Connect instead of the install-wide Stripe account.
TREDARO_CLOUD=

# Enterprise license key (unlocks SSO + passkeys without Tredaro Cloud).
TREDARO_ENTERPRISE_KEY=

# Email (optional). Without a provider, emails are only written to the server log.
EMAIL_FROM=
RESEND_API_KEY=
SMTP_URL=

# Protects /api/cron (daily agreement billing + demo cleanup).
CRON_SECRET=

# Online customer payments (optional). Webhook endpoint: /api/payments/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
