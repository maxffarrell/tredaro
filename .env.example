# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Public demo mode: throwaway sample workspaces, risky features disabled.
TREDARO_DEMO=

# Tredaro Cloud (only the hosted product sets this). Enables per-workspace
# Stripe Connect instead of the install-wide Stripe account.
TREDARO_CLOUD=

# Reserved enterprise license key; no current application feature requires it.
TREDARO_ENTERPRISE_KEY=

# BYOK AI features (no enterprise license required).
# Bring-your-own-key: point at any OpenAI-compatible endpoint; nothing is bundled.
# TREDARO_AI_BASE_URL="https://api.openai.com/v1"
# TREDARO_AI_API_KEY=
# TREDARO_AI_MODEL="gpt-5-mini"
#
# Optional: route structured decision calls (JSON outputs the app parses, e.g.
# dispatch/intake/line-item suggestions) to a different key, model, or gateway.
# Each unset var falls back to its TREDARO_AI_* counterpart, so single-key
# installs don't need anything here.
# TREDARO_AI_DECISION_BASE_URL=
# TREDARO_AI_DECISION_API_KEY=
# TREDARO_AI_DECISION_MODEL=

# Email (optional). Without a provider, emails are only written to the server log.
EMAIL_FROM=
RESEND_API_KEY=
SMTP_URL=

# SMS via Twilio, bring-your-own-account (optional). Set all three to enable
# texts (job scheduled / tech en route / job completed to customers with a phone).
# TREDARO_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TREDARO_TWILIO_AUTH_TOKEN=
# TREDARO_TWILIO_FROM="+15551234567"

# Protects /api/cron (daily agreement billing, reminders/digests, demo cleanup).
UPLOADS_DIR=data/uploads
CRON_SECRET=

# Online customer payments (optional). Webhook endpoint: /api/payments/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
